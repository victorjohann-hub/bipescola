PORT=3000
NODE_ENV=development

# Banco de dados (local: 3306 sem SSL | TiDB Cloud: 4000 com DB_SSL=true)
DB_HOST=localhost
DB_PORT=3306
DB_SSL=false
DB_USER=root
DB_PASSWORD=
DB_NAME=bipescola

# Gere um valor longo e aleatorio. Nunca reutilize o de desenvolvimento em producao.
JWT_SECRET=

# E-mail (recuperacao de senha) - opcional
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
